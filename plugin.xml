<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-navigation-guard"
        version="1.0.0">
    <name>cordova-plugin-navigation-guard</name>
    <description>Enforces native origin containment and URL filtering on Cordova WebViews</description>
    <license>MIT</license>
    <keywords>cordova,security,webview,navigation</keywords>

    <!-- Android -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="NavigationGuard">
                <param name="android-package" value="com.security.guard.NavigationGuardPlugin"/>
                <param name="onload" value="true" />
            </feature>
        </config-file>
        <source-file src="src/android/NavigationGuardPlugin.java" target-dir="src/com/security/guard" />
    </platform>

    <!-- iOS (Swift) -->
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="NavigationGuard">
                <param name="ios-package" value="NavigationGuardPlugin" />
                <param name="onload" value="true" />
            </feature>
			<preference name="SwiftVersion" value="5.0" />
        </config-file>
        <source-file src="src/ios/NavigationGuardPlugin.swift" />
    </platform>
</plugin>