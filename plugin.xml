<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="com.outsystems.security.webviewlockdown"
        version="1.0.0">
    <name>WebView Security Lockdown</name>
    <description>Restricts WebView navigation and intents for OutSystems</description>
    <license>MIT</license>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">

            <allow-navigation href="https://ts11dev.outsystems.net/*" />

            <!-- Disable unsafe eval -->
            <preference name="UnsafeEvalUsage" value="false" />
        </config-file>
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">

            <allow-navigation href="https://ts11dev.outsystems.net/*" />

            <preference name="UnsafeEvalUsage" value="false" />
        </config-file>
    </platform>
</plugin>