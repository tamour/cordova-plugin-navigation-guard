<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="com.outsystems.webviewlockdown"
        version="1.0.0">
    <name>WebView Configuration Lockdown</name>
    <description>Overrides allow-navigation and allow-intent defaults per OutSystems engineering recommendations.</description>

    <!-- Run at every critical phase to survive MABS template regeneration -->
    <hook type="before_prepare" src="scripts/apply-strict-config.js" />
    <hook type="after_prepare" src="scripts/apply-strict-config.js" />
    <hook type="before_compile" src="scripts/apply-strict-config.js" />
</plugin>