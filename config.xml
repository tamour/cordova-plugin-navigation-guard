<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yourcompany.yourapp" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>YourApp</name>
    <description>Your App Description</description>
    <content src="index.html" />

    <!-- 1. Enforce strict WebView origin containment -->
    <!-- Allow local bundle assets -->
    <allow-navigation href="https://localhost/*" />
    
    <!-- Explicitly allow ONLY trusted remote backends inside the WebView -->
    <allow-navigation href="https://ts11dev.outsystems.net/*" />

    <!-- 2. Restrict background network calls (Fetch, XHR, WebSockets) -->
    <access origin="https://api.yourcompany.com" />
    <access origin="https://app.yourcompany.com" />

    <!-- 3. Safe external handoff (Opens Safari/Chrome, NOT the Cordova WebView) -->
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="https://*/*" />

    <!-- 4. Harden preferences (Disallow eval and cleartext HTTP) -->
    <preference name="UnsafeEvalUsage" value="false" />
    <preference name="CleartextTrafficPermitted" value="false" />

</widget>